---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile, publicSafetyNote } from "../data/profile";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const pageTitle = `${profile.name} | Product Manager Portfolio`;
const pageDescription =
  "Product management portfolio focused on commerce, zero-to-one product work, and cross-functional execution.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="hero">
    <div class="hero-intro">
      <p class="eyebrow">Product Management Portfolio</p>
      <h1>{profile.name}</h1>
    </div>
    <div class="hero-copy">
      <p class="hero-positioning">{profile.headline}</p>
      <p class="lead">{profile.summary}</p>
      <div class="proof-strip" aria-label="Portfolio strengths">
        <span>Conversational commerce</span>
        <span>Integration PM</span>
        <span>Cross-functional delivery</span>
      </div>
      <div class="cta-row">
        <a class="button primary" href={`mailto:${profile.email}`}>Email me</a>
        <a class="button secondary" href={profile.linkedin} target="_blank" rel="noreferrer">View LinkedIn</a>
      </div>
    </div>
    <aside class="hero-panel" aria-label="Portfolio focus">
      <div class="panel-topline">
        <p class="panel-label">Current case study</p>
        <a class="panel-link" href={`${base}case-studies/whatsapp-commerce/`}>Read case study</a>
      </div>
      <h2>WhatsApp Commerce</h2>
      <p class="panel-company">ruparupa</p>
      <p class="panel-summary">
        Conversational commerce pilot connecting WhatsApp, ruparupa commerce capabilities, Gupshup, and Meta.
      </p>
      <div class="metric-grid">
        <div>
          <strong>37%</strong>
          <span>lower CAC</span>
        </div>
        <div>
          <strong>15%</strong>
          <span>lower average cost per session</span>
        </div>
      </div>
    </aside>
  </section>

  <section class="section" id="selected-work">
    <div class="section-heading">
      <p class="eyebrow">Selected Work</p>
      <h2>Case Studies</h2>
    </div>
    <div class="case-list">
      <article class="case-card">
        <div>
          <p class="case-meta">ruparupa · Product Manager · Building a 0-to-1 product</p>
          <h3>WhatsApp Commerce</h3>
          <p>
            Exploring whether e-commerce could move from a website into a conversation through WhatsApp,
            ruparupa commerce capabilities, Gupshup, and Meta.
          </p>
        </div>
        <a class="button text" href={`${base}case-studies/whatsapp-commerce/`}>Read case study</a>
      </article>
      <article class="case-card">
        <div>
          <p class="case-meta">ruparupa · Product Manager · Product expansion</p>
          <h3>Purchase With Purchase Promo</h3>
          <p>
            Designing a PWP promotion system that supported multiple promotional SKUs under one Promo ID and
            launched in time for the 12.12 double-date campaign.
          </p>
        </div>
        <a class="button text" href={`${base}case-studies/purchase-with-purchase-promo/`}>Read case study</a>
      </article>
      <article class="case-card">
        <div>
          <p class="case-meta">ruparupa · Product Manager</p>
          <h3>Sync POS Promo</h3>
          <p>Automating offline promotion synchronization to eliminate two hours of daily manual work for the Merchandising team.</p>
        </div>
        <a class="button text" href={`${base}case-studies/sync-pos-promo/`}>Read case study</a>
      </article>
      <article class="case-card">
        <div>
          <p class="case-meta">Qasir · Product Manager</p>
          <h3>Brand Logo</h3>
          <p>Using revenue patterns and merchant interviews to prioritize receipt branding as a premium feature.</p>
        </div>
        <a class="button text" href={`${base}case-studies/brand-logo/`}>Read case study</a>
      </article>
    </div>
  </section>

  <section class="section note-section">
    <p>{publicSafetyNote}</p>
  </section>
</BaseLayout>
