---
import { caseStudies } from "../data/caseStudies";
const current = caseStudies[0];
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---
<section class="case-explorer" aria-label="Explore my product decisions">
  <p class="eyebrow">Explore my product decisions</p>
  <div class="explorer-choices" aria-label="Choose a product challenge">
    {caseStudies.map(c => <a href={`${base}case-studies/${c.slug}/`} data-choice data-title={c.title} aria-current={c.slug === current.slug ? "true" : undefined}>
      <strong>{c.challenge}</strong><span>{c.title}</span><small>{c.metric}</small>
    </a>)}
  </div>
  <p class="explorer-footer" aria-live="polite">
    <a class="explorer-full" href={`${base}case-studies/${current.slug}/`}>
      <span data-selected-title>{current.title}</span><span> — Read the full story →</span>
    </a>
  </p>
</section>
<script>
  for (const root of document.querySelectorAll<HTMLElement>(".case-explorer")) {
    const links = root.querySelectorAll<HTMLAnchorElement>("[data-choice]");
    const storyLink = root.querySelector<HTMLAnchorElement>(".explorer-full")!;
    const title = root.querySelector<HTMLElement>("[data-selected-title]")!;
    links.forEach(link => link.addEventListener("click", event => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      title.textContent = link.dataset.title!;
      storyLink.href = link.href;
      links.forEach(choice => {
        if (choice === link) choice.setAttribute("aria-current", "true");
        else choice.removeAttribute("aria-current");
      });
    }));
  }
</script>
<style>
  .case-explorer { min-width: 0; }
  .case-explorer .eyebrow { margin-bottom: 12px; }
  .explorer-choices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; }
  .explorer-choices a { padding: 8px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); text-decoration: none; line-height: 1.4; }
  .explorer-choices a[aria-current="true"] { background: var(--aqua); border-color: var(--green); }
  .explorer-choices a:hover { border-color: var(--green); }
  .explorer-choices strong, .explorer-choices span, .explorer-choices small { display: block; }
  .explorer-choices strong { font-size: .86rem; color: var(--green-dark); }
  .explorer-choices span { font-size: .82rem; margin-top: 4px; }
  .explorer-choices small { font-size: .78rem; color: var(--muted); margin-top: 4px; }
  .explorer-footer { margin: 12px 0 0; padding-top: 8px; border-top: 1px solid var(--line); }
  .explorer-full { display: block; padding: 6px 0; font-size: .86rem; font-weight: 700; color: var(--green-dark); overflow-wrap: anywhere; }
  @media (max-width: 360px) { .explorer-choices { grid-template-columns: 1fr; } }
</style>
